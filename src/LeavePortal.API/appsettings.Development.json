{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=leaveportal.dev.db",
    "Storage": "UseDevelopmentStorage=true"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "JwtSettings": {
    "Secret": "LocalDevSecretKeyMustBeAtLeast32CharactersLong!",
    "Issuer": "LeavePortal",
    "Audience": "LeavePortalUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Storage": {
    "ReceiptsContainer": "receipts"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
