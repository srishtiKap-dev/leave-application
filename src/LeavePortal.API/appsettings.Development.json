  },
  "Jwt": {
    "Issuer": "LeavePortal",
    "Audience": "LeavePortal.Frontend",
    "SigningKey": "dev-key-change-this-dev-key-change-this"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "ReceiptsContainer": "receipts"
  },
  "Logging": {
