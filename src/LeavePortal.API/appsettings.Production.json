{
  "ConnectionStrings": {
    "DefaultConnection": "Host=psql-leaveportal-prod.postgres.database.azure.com;Database=leaveportaldb;Username=leaveportal_admin;Password=#{DB_PASSWORD}#;SSL Mode=Require;"
  },
  "Database": {
    "Provider": "PostgreSQL"
  },
  "JwtSettings": {
    "Secret": "#{JWT_SECRET}#",
    "Issuer": "LeavePortal",
    "Audience": "LeavePortalUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "FileStorage": {
    "Provider": "AzureBlob",
    "ConnectionString": "#{STORAGE_CONNECTION_STRING}#",
    "ContainerName": "receipts"
  },
  "Email": {
    "Provider": "SendGrid",
    "ApiKey": "#{SENDGRID_API_KEY}#"
  },
  "ApplicationInsights": {
    "ConnectionString": "#{APPINSIGHTS_CONNECTION_STRING}#"
  },
  "AllowedOrigins": []
}
